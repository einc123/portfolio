# MailerSend (contact + client invites)
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=noreply@euanliv.click
MAILERSEND_FROM_NAME=Euan Livingstone
CONTACT_TO_EMAIL=hello@euanliv.click

# Cloudflare D1
# local  = SQLite file at .data/euanliv-click.sqlite (default for next dev)
# remote = Cloudflare D1 HTTP API (needs account id + API token)
# binding = Workers/Pages D1 binding named DB (OpenNext / production)
# auto   = binding → remote (if creds) → local
CLOUDFLARE_D1_MODE=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=df8d7356-f8ff-45d0-90db-7378540e0273
D1_LOCAL_PATH=

# Auth / WebAuthn (generate a long random AUTH_SECRET)
AUTH_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Euan Livingstone Client Portal
WEBAUTHN_ORIGIN=http://localhost:3000

# Optional admin seed (npm run db:seed-admin)
ADMIN_EMAIL=hello@euanliv.click
ADMIN_PASSWORD=
ADMIN_ORG_NAME=Euan Livingstone

# Stripe (Billing — keep secret key server-side only)
# Local: use sk_test_ / pk_test_ keys
# Production (Cloudflare): set STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY to live sk_live_ / pk_live_ secrets
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
