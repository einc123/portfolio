{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Cloudflare Worker name used by Workers Builds ("portfolio").
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep dashboard Variables & Secrets (MailerSend, Stripe publishable key, etc.).
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "euanliv.click",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "portfolio-opennext-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "euanliv-click",
      "database_id": "df8d7356-f8ff-45d0-90db-7378540e0273",
      "migrations_dir": "migrations",
      // Use the live D1 database during `next dev` / OpenNext build (not an empty local stub).
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
